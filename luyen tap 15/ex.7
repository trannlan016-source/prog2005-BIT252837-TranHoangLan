def tinh_diem_trung_binh(danh_sach_sv):
    if not danh_sach_sv:
        return 0
    tong_diem = sum(danh_sach_sv.values())
    so_sv = len(danh_sach_sv)
    return tong_diem / so_sv

sinh_vien = {
    "Lan": 8.5,
    "duc": 7.0,
    "tuyen": 9.0
}

dtb = tinh_diem_trung_binh(sinh_vien)
print(f"diem trung binh cua {len(sinh_vien)} sinh vien la: {dtb}")
